# ─── Nourishly Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your values.

# Backend server port
PORT=3001

# JWT signing secret — change this to a long random string in production
JWT_SECRET=nourishly_super_secret_jwt_key_change_this_in_production_2025

# Groq AI API key — 100% FREE, no credit card needed
# Get yours at: https://console.groq.com → "API Keys" → "Create API Key"
# Powers: AI description generation, ingredient substitution, fridge recipes
GROQ_AI_KEY=your-groq-key-here

# Google OAuth Client ID — for "Sign in with Google" on login/signup pages
# Get it at: https://console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# Set Authorized JavaScript origins: http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id-here

# n8n webhook base URL (only needed if running n8n)
N8N_WEBHOOK_BASE=http://localhost:5678/webhook

# Node environment
NODE_ENV=development
